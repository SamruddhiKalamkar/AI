import heapq

start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

def heuristic(state):
    distance = 0
    for i in range(9):
        if state[i] != 0:
            pos = goal.index(state[i])
            distance += abs(i // 3 - pos // 3)
            distance += abs(i % 3 - pos % 3)
    return distance

def get_neighbors(state):
    neighbors = []
    zero = state.index(0)
    row, col = zero // 3, zero % 3

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dr, dc in moves:
        r, c = row + dr, col + dc

        if 0 <= r < 3 and 0 <= c < 3:
            new_pos = r * 3 + c
            temp = list(state)
            temp[zero], temp[new_pos] = temp[new_pos], temp[zero]
            neighbors.append(tuple(temp))

    return neighbors

def display(state):
    for i in range(0, 9, 3):
        print(state[i:i+3])
    print()

def a_star(start):
    pq = [(heuristic(start), 0, start)]
    visited = set()

    print("Initial State:")
    display(start)

    while pq:
        f, g, state = heapq.heappop(pq)

        if state in visited:
            continue

        visited.add(state)

        print("Current State:")
        display(state)
        print("----------------")

        if state == goal:
            print("Goal Reached!")
            print("Total Moves:", g)
            return

        for neighbor in get_neighbors(state):
            if neighbor not in visited:
                new_g = g + 1
                new_f = new_g + heuristic(neighbor)
                heapq.heappush(pq, (new_f, new_g, neighbor))

    print("No solution found")

a_star(start)
